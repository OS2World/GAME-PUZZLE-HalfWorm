DLGTEMPLATE DLG_KM_JOY LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    DIALOG "", DLG_KM_JOY, 0, 0, 230, 168, WS_VISIBLE
            PRESPARAMS PP_FONTNAMESIZE, "9.WarpSans"
    BEGIN
        AUTOCHECKBOX "",       IDC_KM_JEN,     4, 154, 180, 11, WS_GROUP
        CTEXT "",              IDC_KM_JH1,     4, 142, 222,  9
        CTEXT "",              IDC_KM_JH2,     4, 132, 222,  9
        LTEXT "",              IDC_KM_JP1,     4, 118,  50,  9
        AUTORADIOBUTTON "",    IDC_KM_JP1A,   60, 117,  72, 11, WS_GROUP
        AUTORADIOBUTTON "",    IDC_KM_JP1B,  136, 117,  72, 11
        LTEXT "",              IDC_KM_JLBL+0,  8, 104, 100,  9
        ENTRYFIELD "",         IDC_KM_JBOX+0,112, 102, 108, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP | WS_GROUP
        LTEXT "",              IDC_KM_JLBL+1,  8,  90, 100,  9
        ENTRYFIELD "",         IDC_KM_JBOX+1,112,  88, 108, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        LTEXT "",              IDC_KM_JLBL+2,  8,  76, 100,  9
        ENTRYFIELD "",         IDC_KM_JBOX+2,112,  74, 108, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        LTEXT "",              IDC_KM_JP2,     4,  60,  50,  9
        AUTORADIOBUTTON "",    IDC_KM_JP2A,   60,  59,  72, 11, WS_GROUP
        AUTORADIOBUTTON "",    IDC_KM_JP2B,  136,  59,  72, 11
        LTEXT "",              IDC_KM_JLBL+3,  8,  46, 100,  9
        ENTRYFIELD "",         IDC_KM_JBOX+3,112,  44, 108, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP | WS_GROUP
        LTEXT "",              IDC_KM_JLBL+4,  8,  32, 100,  9
        ENTRYFIELD "",         IDC_KM_JBOX+4,112,  30, 108, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        LTEXT "",              IDC_KM_JLBL+5,  8,  18, 100,  9
        ENTRYFIELD "",         IDC_KM_JBOX+5,112,  16, 108, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        PUSHBUTTON "",         IDC_KM_JCALA,   4,   0, 100, 13, WS_GROUP
        PUSHBUTTON "",         IDC_KM_JCALB, 110,   0, 100, 13
    END
END


DLGTEMPLATE IDD_ABOUT LOADONCALL MOVEABLE
BEGIN
    DIALOG "About HalfWorm", IDD_ABOUT, 32, 24, 240, 110, WS_VISIBLE | WS_SAVEBITS, FCF_TITLEBAR | FCF_DLGBORDER
    BEGIN
        CTEXT "HalfWorm for OS/2",           -1, 10, 90, 220, 8
        CTEXT "Version 1.0",                 -1, 10, 78, 220, 8
        CTEXT "OpenWatcom Release",          -1, 10, 66, 220, 8
        CTEXT "(c) 1997, Jan M. Danielsson", -1, 10, 54, 220, 8
        CTEXT "(c) 2026, OS2World",          -1, 10, 42, 220, 8
        CTEXT "BSD 3-Clause License",        -1, 10, 30, 220, 8
        DEFPUSHBUTTON "Close", DID_OK,       98,  8, 44, 14, WS_GROUP
    END
END


HELPTABLE MAIN_HELP_TABLE
{
   HELPITEM WIN_HALFWORM,    SUBTABLE_MAIN,   PANEL_INTRO
   HELPITEM IDD_ABOUT,       SUBTABLE_ABOUT,  PANEL_COPYRIGHT
   HELPITEM DLG_BOARD_SIZE,  SUBTABLE_BOARD,  PANEL_BOARDDLG
   HELPITEM IDD_KEY_MAPPING, SUBTABLE_KEYS,   PANEL_KEYSDLG
   HELPITEM DLG_SFXVOLUME,   SUBTABLE_VOLUME, PANEL_VOLDLG
}

